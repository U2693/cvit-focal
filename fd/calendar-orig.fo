1.10 T !"CVIT CALENDAR  (DAY 0 = MON 1 JAN 1900)"!
1.20 T !"1 MONTH 2 YEAR 3 DATE 4 BETWEEN 0 QUIT"!
1.30 A "CHOICE "C;I (C) 1.9,1.9
1.40 I (C-1) 1.2,1.5;I (C-2) 1.2,1.6;I (C-3) 1.2,1.7
1.45 I (C-4) 1.2,1.8;G 1.2
1.50 D 11;G 1.2
1.60 D 12;G 1.2
1.70 D 13;G 1.2
1.80 D 14;G 1.2
1.90 T "BYE"!;G 99.99
2.01 C LEAP L FROM Y; DAYS IN MONTH N FROM M,L
2.10 S A=Y-Y/4*4;S B=Y-Y/100*100;S K=Y/100;S K=K-K/4*4
2.20 S L=1-(1/(B*B+1))*(1-1/(K*K+1));S L=L*(1/(A*A+1))
2.30 S K=M+M/8;S N=30+K-K/2*2
2.40 S N=N-(2-L)*(1/((M-2)*(M-2)+1))
3.01 C DAY NUMBER H*10000+R AND WEEKDAY W (0=SUN)
3.10 S K=Y-1900;S A=K/50;S B=K-A*50;S H=0;S R=0
3.20 S X=18250;F I=1,A;D 4.1
3.30 S X=365*B;D 4.1
3.40 S K=Y-1;S X=K/4-K/100+K/400-460;D 4.1
3.50 S X=275*M/9-(2-L)*((M+9)/12)+D-31;D 4.1
3.60 S W=H*4+R+1;S W=W-W/7*7
4.10 S R=R+X;S H=H+R/10000;S R=R-R/10000*10000
5.01 C ONE CALENDAR CELL FOR DAY J
5.10 T " ";I (J-10) 5.2,5.3,5.3
5.20 T " "
5.30 T J;S X=W+J;I (X/7*7-X) 5.5
5.40 T !
5.50 C
6.01 C PRINT H*10000+R
6.10 I (H) 6.5,6.5;T H;I (R-1000) 6.2,6.5,6.5
6.20 T "0";I (R-100) 6.3,6.5,6.5
6.30 T "0";I (R-10) 6.4,6.5,6.5
6.40 T "0"
6.50 T R
7.01 I (1-M) 7.02;T "JANUARY";R
7.02 I (2-M) 7.03;T "FEBRUARY";R
7.03 I (3-M) 7.04;T "MARCH";R
7.04 I (4-M) 7.05;T "APRIL";R
7.05 I (5-M) 7.06;T "MAY";R
7.06 I (6-M) 7.07;T "JUNE";R
7.07 I (7-M) 7.08;T "JULY";R
7.08 I (8-M) 7.09;T "AUGUST";R
7.09 I (9-M) 7.10;T "SEPTEMBER";R
7.10 I (10-M) 7.11;T "OCTOBER";R
7.11 I (11-M) 7.12;T "NOVEMBER";R
7.12 T "DECEMBER"
8.01 I (-W) 8.02;T "SUNDAY";R
8.02 I (1-W) 8.03;T "MONDAY";R
8.03 I (2-W) 8.04;T "TUESDAY";R
8.04 I (3-W) 8.05;T "WEDNESDAY";R
8.05 I (4-W) 8.06;T "THURSDAY";R
8.06 I (5-W) 8.07;T "FRIDAY";R
8.07 T "SATURDAY"
9.01 C ASK DATE: F=0 YEAR, 1 +MONTH, 2 +DAY; E=1 IF BAD
9.10 S E=0;A "YEAR "Y;I (Y-1900) 9.8;I (9999-Y) 9.8
9.20 I (F) 9.9,9.9;A "MONTH "M;I (M-1) 9.8;I (12-M) 9.8
9.30 D 2;I (F-1) 9.9,9.9;A "DAY "D;I (D-1) 9.8
9.40 I (N-D) 9.8;R
9.80 T "?BAD DATE (1900-9999)"!;S E=1
9.90 C
10.01 C PRINT MONTH M OF YEAR Y
10.10 T !"   ";D 7;T " "Y!
10.20 T "  S  M  T  W  T  F  S"!
10.30 D 2;S D=1;D 3;F I=1,W;T "   "
10.40 F J=1,N;D 5
10.50 S X=W+N;I (X/7*7-X) 10.6;R
10.60 T !
11.10 S F=1;D 9;I (-E) 11.9;D 10
11.90 C
12.10 S F=0;D 9;I (-E) 12.9;F M=1,12;D 10
12.90 C
13.10 S F=2;D 9;I (-E) 13.9;D 3
13.20 T !;D 8;T ", ";D 7;T " "D", "Y!
13.30 T "DAY NUMBER ";D 6;T !
13.90 C
14.01 C DAYS FROM FIRST DATE TO SECOND
14.10 T "FIRST DATE"!;S F=2;D 9;I (-E) 14.9
14.20 D 3;S U=H;S V=R
14.30 T "SECOND DATE"!;D 9;I (-E) 14.9;D 3
14.40 S H=H-U;S R=R-V;S S=0
14.50 I (R) 14.55,14.6,14.6
14.55 S R=R+10000;S H=H-1
14.60 I (H) 14.65,14.8,14.8
14.65 S H=-H;S R=-R;S S=1;G 14.5
14.80 T !"DIFFERENCE ";I (S) 14.82,14.82;T "-"
14.82 D 6;T " DAYS"!
14.90 C
